{
  "name": "@andy/server",
  "version": "1.0.0",
  "private": true,
  "description": "Andy API — Hono server that turns diagram images into circuit-lab YAML via Cursor SDK or Gemini.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.24",
    "@google/genai": "^1.0.0",
    "@hono/node-server": "^1.14.3",
    "dotenv": "^17.4.2",
    "hono": "^4.8.3",
    "js-yaml": "^4.3.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.30",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
