# Andy server environment (Cloudflare Worker bindings)
#
# Local: copy to server/.dev.vars (Wrangler / Vite Cloudflare plugin).
# Production: set non-secrets in wrangler.jsonc `vars`; secrets via:
#   npx wrangler secret put GEMINI_API_KEY

# gemini | meta | demo
# demo = offline fixture YAML for UI walkthroughs / videos (no API key)
AI_PROVIDER=demo

# --- Gemini (multimodal diagram → YAML) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Meta (OpenAI SDK → https://api.meta.ai/v1) ---
META_API_KEY=
META_MODEL=muse-spark-1.1
# META_BASE_URL=https://api.meta.ai/v1

CORS_ORIGINS=*
# Max diagram upload size (bytes). Default 20 MiB if unset.
MAX_UPLOAD_BYTES=20971520

# --- WorkOS (protects /author + /api/diagrams) ---
# Dashboard: https://dashboard.workos.com
# Enable Email + Password and Magic Auth under Authentication.
# Redirect URI: http://localhost:6767/callback
# Sign-in endpoint: http://localhost:6767/auth/initiate (impersonation)
# Sign-out redirect: http://localhost:6767/
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=
# Optional; defaults to {request origin}/callback
# WORKOS_REDIRECT_URI=http://localhost:6767/callback
# Optional — auto-select Andy org + add new signups to it (Dashboard → Organizations)
# WORKOS_ORGANIZATION_ID=org_...
