# Andy server environment
#
# Copy to server/.env (or export in your shell) before running the API.

# cursor (default) | gemini | demo
# demo = offline fixture YAML for UI walkthroughs / videos (no API key)
AI_PROVIDER=cursor

# --- Cursor SDK (short-term / Grok 4.5 path) ---
# Create a key: Cursor Dashboard → API Keys
CURSOR_API_KEY=
# Model id on your account. Try grok-4.5, composer-2.5, or auto.
# Discover with: node -e "import('@cursor/sdk').then(async ({Cursor})=>console.log(await Cursor.models.list()))"
CURSOR_MODEL=grok-4.5

# --- Gemini (direct multimodal; good long-term default) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

PORT=3001
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_BYTES=8388608
