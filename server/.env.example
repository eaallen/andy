# Andy server environment
#
# Copy to server/.env (or export in your shell) before running the API.

# gemini (default) | meta | demo
# demo = offline fixture YAML for UI walkthroughs / videos (no API key)
AI_PROVIDER=gemini

# --- Gemini (multimodal diagram → YAML) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Meta (OpenAI SDK → https://api.meta.ai/v1) ---
META_API_KEY=
META_MODEL=muse-spark-1.1
# META_BASE_URL=https://api.meta.ai/v1

PORT=3001
CORS_ORIGINS=http://localhost:5173
# Max diagram upload size (bytes). Default 20 MiB if unset.
MAX_UPLOAD_BYTES=20971520
