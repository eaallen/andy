{
  "name": "andy-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Remote Electrician Lab (Andy) — circuit lab client library + Cloudflare Worker site/API.",
  "workspaces": [
    "frontend",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w @andy/server",
    "dev:frontend": "npm run dev -w @andy/frontend",
    "dev:server": "npm run dev -w @andy/server",
    "build": "npm run build -w @andy/server",
    "build:frontend": "npm run build -w @andy/frontend",
    "build:lib": "npm run build:lib -w @andy/frontend",
    "build:server": "npm run build -w @andy/server",
    "deploy": "npm run deploy -w @andy/server",
    "test": "npm run test -w @andy/frontend && npm run test -w @andy/server",
    "test:frontend": "npm run test -w @andy/frontend",
    "test:server": "npm run test -w @andy/server",
    "typecheck": "npm run typecheck -w @andy/server"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eaallen/andy.git"
  },
  "license": "ISC",
  "engines": {
    "node": ">=20"
  }
}
